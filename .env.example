# righthand LLM provider credentials — copy to `.env` and fill in.
# Values are referenced from config.json via `env:` indirection, so the secret
# never lives in config.json or righthand's output.

# DeepSeek (OpenAI-compatible). CHAT_BASE_URL must point at the /v1 (or bare)
# chat-completions root, e.g. https://api.deepseek.com/v1
DEEPSEEK_API_KEY=""
CHAT_MODEL=""
CHAT_BASE_URL=""
