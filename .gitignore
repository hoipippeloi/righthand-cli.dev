# secrets — never commit
.env
.env.*
!.env.example

# dependencies
node_modules/

# righthand's own runtime footprint (local state; recreated by `righthand init`)
.righthand/

# pi agent session/config state (machine-local)
.pi/

# scratch & build artifacts
.work/
# dist/ is COMMITTED on purpose — it's the published artifact shipped in the
# GitHub tarball so `npm install -g <tarball-url>` works without a build step
# (npm's git-dep global-install flow is buggy: npm/cli#3692).
